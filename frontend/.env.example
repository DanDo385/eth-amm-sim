# Optional: point REST at Go directly (bypasses Next /api proxy).
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: WebSocket URL (required if the UI is https and Go is on another host).
# NEXT_PUBLIC_WS_URL=wss://your-backend.example.com/stream

# Vercel / remote preview: where Next should proxy /api/* (server-side rewrite).
# Set in Vercel → Settings → Environment Variables (not NEXT_PUBLIC_*).
# BACKEND_PROXY_URL=https://your-go-backend.example.com
