# Optional: point REST at Go directly (bypasses Vite dev proxy /api → :8080).
# On Vercel, leave this unset so the browser calls same-origin `/api/*`
# (rewritten to https://api-staging-eth-amm-sim.magro.dev in vercel.json).
# VITE_API_URL=http://127.0.0.1:8080

# Optional: WebSocket URL (required if the UI is https and Go is on another host).
# Production (Vercel): set in .env.production / Vercel env to the Ubuntu tunnel.
# VITE_WS_URL=wss://api-staging-eth-amm-sim.magro.dev/stream

# Dev only: where Vite proxies /api/* when running `npm run dev` / `npm run preview`.
# Defaults to http://127.0.0.1:8080 if unset.
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8080
