# Production build (Vercel UI → Ubuntu via Cloudflare Tunnel).
# Call the tunnel origin directly for REST and WS. Vercel external rewrites to
# api-staging-eth-amm-sim.magro.dev are flaky (intermittent empty 404s); CORS on
# the Go backend already allows https://eth-amm-sim.vercel.app.
VITE_API_URL=https://api-staging-eth-amm-sim.magro.dev
VITE_WS_URL=wss://api-staging-eth-amm-sim.magro.dev/stream
