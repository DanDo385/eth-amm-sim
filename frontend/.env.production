# Production build (Vercel UI hostname is the public REST origin).
# Leave VITE_API_URL unset so fetch() uses same-origin /api/* on
# https://eth-amm-sim.vercel.app — rewritten in vercel.json to the Ubuntu
# Cloudflare Tunnel. WebSocket cannot use Vercel rewrites, so /stream still
# opens on the tunnel hostname.
VITE_WS_URL=wss://api-staging-eth-amm-sim.magro.dev/stream
